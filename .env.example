NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/kdrama

# Authentification (génère une longue chaîne aléatoire, ex: openssl rand -base64 48)
AUTH_SECRET=change-moi

# Stockage vidéo / images (objet compatible S3, CDN, etc.)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

NEXT_PUBLIC_SITE_NAME=K-Drama
NEXT_PUBLIC_SITE_URL=http://localhost:3000
